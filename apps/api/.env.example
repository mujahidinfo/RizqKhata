NODE_ENV="development"
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/genpos"

# Secret used to sign access tokens (min 32 chars). In production the API
# refuses to start with the example value below.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"
JWT_ACCESS_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

PORT=4000
# Comma-separated browser origins allowed by CORS (iOS/Android apps don't need
# this): the Rizq Khata app's web build, e.g. "https://app.rizqkhata.com".
CORS_ORIGINS="http://localhost:8081"
# Reverse proxies in front of the API: 1 behind Coolify/Traefik, 0 locally.
TRUST_PROXY=0

# Google sign-in: comma-separated OAuth client IDs (web, Android, iOS) whose ID
# tokens are accepted. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_IDS=""

# Product photos: UploadThing server token (from uploadthing.com → API Keys).
# Leave empty to disable photo uploads.
UPLOADTHING_TOKEN=""
